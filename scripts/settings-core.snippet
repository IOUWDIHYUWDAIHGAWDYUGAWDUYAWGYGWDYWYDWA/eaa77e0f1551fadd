const settingSections={overview:['Genel Bakış','Tüm sistemlerin canlı özeti'],security:['Güvenlik','Koruma katmanlarını yönet'],roles:['Roller','Otomatik ve doğrulama rollerini seç'],tickets:['Ticket','Destek ekibi ve kategoriyi bağla'],logs:['Kayıtlar','Log ve karşılama kanallarını seç']};
function settingItems(g,s,section){
 const role=id=>id?(g.roles.cache.get(id)?.name||'Silinmiş rol'):'Ayarlanmadı',channel=id=>id?(g.channels.cache.get(id)?.name||'Silinmiş kanal'):'Ayarlanmadı';
 if(section==='security')return [{name:'Anti-Nuke',desc:'Yıkıcı işlemleri sınırlar',enabled:s.security.antiNuke},{name:'Anti-Link',desc:'İzinsiz bağlantıları temizler',enabled:s.security.antiLink},{name:'Anti-Spam',desc:'Mesaj saldırılarını durdurur',enabled:s.security.antiSpam},{name:'Küfür Filtresi',desc:'Riskli içeriği kaldırır',enabled:s.security.antiSwear}];
 if(section==='roles')return [{name:'Otomatik Rol',desc:'Yeni üyelere verilen rol',enabled:!!s.autoRole,value:role(s.autoRole)},{name:'Doğrulama Rolü',desc:'Doğrulanan üyelere verilir',enabled:!!s.verifyRole,value:role(s.verifyRole)}];
 if(section==='tickets')return [{name:'Destek Ekibi',desc:'Ticket kanallarını görebilir',enabled:!!s.supportRole,value:role(s.supportRole)},{name:'Ticket Kategorisi',desc:'Yeni kanallar burada açılır',enabled:!!s.ticketCategory,value:channel(s.ticketCategory)}];
 if(section==='logs')return [{name:'Moderasyon Logu',desc:'Yönetim kayıtlarının kanalı',enabled:!!s.modLog,value:channel(s.modLog)},{name:'Karşılama Kanalı',desc:'Yeni üye görsellerinin kanalı',enabled:!!s.welcomeChannel,value:channel(s.welcomeChannel)}];
 return [{name:'Güvenlik',desc:'Anti-nuke, link, spam ve filtre',enabled:Object.values(s.security).some(Boolean),value:`${Object.values(s.security).filter(Boolean).length}/4 aktif`},{name:'Roller',desc:'Otomatik ve doğrulama rolleri',enabled:!!(s.autoRole||s.verifyRole),value:[s.autoRole,s.verifyRole].filter(Boolean).length+'/2 bağlı'},{name:'Ticket',desc:'Özel destek kanalı sistemi',enabled:!!(s.supportRole||s.ticketCategory),value:[s.supportRole,s.ticketCategory].filter(Boolean).length+'/2 bağlı'},{name:'Kayıtlar',desc:'Mod log ve karşılama kanalı',enabled:!!(s.modLog||s.welcomeChannel),value:[s.modLog,s.welcomeChannel].filter(Boolean).length+'/2 bağlı'}];
}
function settingComponents(i,section,s){
 const uid=i.user.id,rows=[new ActionRowBuilder().addComponents(new StringSelectMenuBuilder().setCustomId(`settings:${uid}`).setPlaceholder('Yönetim bölümünü seç').addOptions(Object.entries(settingSections).map(([value,v])=>({label:v[0],description:v[1],value,default:value===section}))))];
 if(section==='overview')rows.push(new ActionRowBuilder().addComponents(
  new ButtonBuilder().setCustomId(`section:security:${uid}`).setLabel('Güvenlik').setEmoji('🛡️').setStyle(ButtonStyle.Primary),
  new ButtonBuilder().setCustomId(`section:roles:${uid}`).setLabel('Roller').setEmoji('🎭').setStyle(ButtonStyle.Secondary),
  new ButtonBuilder().setCustomId(`section:tickets:${uid}`).setLabel('Ticket').setEmoji('🎫').setStyle(ButtonStyle.Secondary),
  new ButtonBuilder().setCustomId(`section:logs:${uid}`).setLabel('Kayıtlar').setEmoji('📋').setStyle(ButtonStyle.Secondary)));
 if(section==='security')rows.push(new ActionRowBuilder().addComponents(...[['antiNuke','Anti-Nuke'],['antiLink','Anti-Link'],['antiSpam','Anti-Spam'],['antiSwear','Filtre']].map(([key,label])=>new ButtonBuilder().setCustomId(`toggle:${key}:${uid}`).setLabel(label).setStyle(s.security[key]?ButtonStyle.Success:ButtonStyle.Danger))));
 if(section==='roles'){rows.push(new ActionRowBuilder().addComponents(new RoleSelectMenuBuilder().setCustomId(`setrole:autoRole:${uid}`).setPlaceholder('Otomatik rolü seç')));rows.push(new ActionRowBuilder().addComponents(new RoleSelectMenuBuilder().setCustomId(`setrole:verifyRole:${uid}`).setPlaceholder('Doğrulama rolünü seç')));}
 if(section==='tickets'){rows.push(new ActionRowBuilder().addComponents(new RoleSelectMenuBuilder().setCustomId(`setrole:supportRole:${uid}`).setPlaceholder('Destek ekibi rolünü seç')));rows.push(new ActionRowBuilder().addComponents(new ChannelSelectMenuBuilder().setCustomId(`setchannel:ticketCategory:${uid}`).setPlaceholder('Ticket kategorisini seç').setChannelTypes(ChannelType.GuildCategory)));}
 if(section==='logs'){rows.push(new ActionRowBuilder().addComponents(new ChannelSelectMenuBuilder().setCustomId(`setchannel:modLog:${uid}`).setPlaceholder('Moderasyon log kanalını seç').setChannelTypes(ChannelType.GuildText,ChannelType.GuildAnnouncement)));rows.push(new ActionRowBuilder().addComponents(new ChannelSelectMenuBuilder().setCustomId(`setchannel:welcomeChannel:${uid}`).setPlaceholder('Karşılama kanalını seç').setChannelTypes(ChannelType.GuildText,ChannelType.GuildAnnouncement)));}
 if(section!=='overview')rows.push(new ActionRowBuilder().addComponents(new ButtonBuilder().setCustomId(`section:overview:${uid}`).setLabel('Kontrol Merkezine Dön').setEmoji('↩️').setStyle(ButtonStyle.Secondary),new ButtonBuilder().setLabel('Web Panel').setEmoji('🌐').setURL(cfg.website).setStyle(ButtonStyle.Link)));
 else rows.push(new ActionRowBuilder().addComponents(new ButtonBuilder().setLabel('Web Paneli Aç').setEmoji('🌐').setURL(cfg.website).setStyle(ButtonStyle.Link)));
 return rows;
}
async function settingsPayload(i,section='overview'){
 if(!i.member.permissions.has(PermissionFlagsBits.ManageGuild))return fail(i,'Sunucu ayarlarını açmak için Sunucuyu Yönet izni gerekli.');
 const s=guildSettings(i.guild),meta=settingSections[section]||settingSections.overview,file=new AttachmentBuilder(await cards.settingsDashboard({guildName:i.guild.name,guildIcon:i.guild.iconURL({extension:'png',size:256})||'',section:meta[0],subtitle:meta[1],items:settingItems(i.guild,s,section)}),{name:'vybot-settings.png'}),payload={files:[file],components:settingComponents(i,section,s),allowedMentions:{parse:[]}};
 if(i.deferred||i.replied)return i.editReply(payload);return i.reply({...payload,ephemeral:true});
}
